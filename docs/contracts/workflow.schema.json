        "sourcePortId",
        "targetNodeId",
        "targetPortId"
      ],
      "title": "WorkflowEdge",
      "type": "object"
    },
    "WorkflowGroup": {
      "additionalProperties": true,
      "properties": {
        "appearance": {
          "additionalProperties": true,
          "title": "Appearance",
          "type": "object"
        },
        "color": {
          "default": "accent",
          "title": "Color",
          "type": "string"
        },
        "height": {
          "default": 240,
          "title": "Height",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "flow",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "Group",
          "title": "Label",
          "type": "string"
        },
        "nodeIds": {
          "items": {
            "type": "string"
          },
          "title": "Nodeids",
          "type": "array"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "startNodeIds": {
          "items": {
            "type": "string"
          },
          "title": "Startnodeids",
          "type": "array"
        },
        "width": {
          "default": 360,
          "title": "Width",
          "type": "number"
        }
      },
      "title": "WorkflowGroup",
      "type": "object"
    },
    "WorkflowNode": {
      "additionalProperties": true,
      "properties": {
        "appearance": {
          "additionalProperties": true,
          "title": "Appearance",
          "type": "object"
        },
        "collapsed": {
          "default": false,
          "title": "Collapsed",
          "type": "boolean"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "schemaId": {
          "title": "Schemaid",
          "type": "string"
        },
        "schemaVersion": {
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "schemaId"
      ],
      "title": "WorkflowNode",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/WorkflowEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "format": {
      "const": "midgard-workflow",
      "default": "midgard-workflow",
      "title": "Format",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/WorkflowGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "default": "Untitled workflow",
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/WorkflowNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "projectSettings": {
      "additionalProperties": true,
      "title": "Projectsettings",
      "type": "object"
    },
    "updatedAt": {
      "format": "date-time",
      "title": "Updatedat",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "viewport": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Viewport",
      "type": "object"
    }
  },
  "title": "WorkflowDocument",
  "type": "object"
}
