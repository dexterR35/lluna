      "properties": {
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "Position",
      "type": "object"
    },
    "WorkflowEdge": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sourceNodeId": {
          "title": "Sourcenodeid",
          "type": "string"
        },
        "sourcePortId": {
          "title": "Sourceportid",
          "type": "string"
        },
        "targetNodeId": {
          "title": "Targetnodeid",
          "type": "string"
        },
        "targetPortId": {
          "title": "Targetportid",
          "type": "string"
        }
      },
      "required": [
