{
  "name": "@midgard/desktop",
  "version": "1.4.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "dev:renderer": "vite --config vite.renderer.config.js",
    "build": "vite build --config vite.renderer.config.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint src electron tests",
    "check": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run --config vite.renderer.config.js",
    "test:watch": "vitest --config vite.renderer.config.js",
    "test:e2e": "npm run build && vite build --config vite.e2e.config.js && playwright test --config playwright.config.js"
  },
  "dependencies": {
    "@xyflow/react": "12.8.4",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/events": "^3.0.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.2.0",
    "eslint": "9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
