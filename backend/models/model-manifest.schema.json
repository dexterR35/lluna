{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midgard.local/schemas/model-manifest-v1.json",
  "title": "Midgard model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "task", "adapter", "source", "runtime"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "legacyId": { "type": "string" },
    "managedBy": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "task": {
      "enum": [
        "text-to-image", "image-to-image", "image-segmentation",
        "object-detection", "image-upscaling", "image-restoration",
        "inpainting", "text-recognition", "text-generation",
        "automatic-speech-recognition", "custom"
      ]
    },
    "adapter": {
      "enum": ["diffusers", "transformers", "paddle", "midgard-native", "python-worker", "supir"]
    },
    "license": { "type": "string" },
    "gated": { "type": "boolean" },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["huggingface", "local", "bundled", "url"] },
        "repo": { "type": "string" },
        "revision": { "type": "string" },
        "url": { "type": "string" },
        "allowPatterns": { "type": "array", "items": { "type": "string" } },
        "localName": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string" },
        "packages": { "type": "array", "items": { "type": "string" } },
        "isolated": { "type": "boolean" }
      }
    },
    "hardware": {
      "type": "object",
      "properties": {
        "backends": {
          "type": "array",
          "items": { "enum": ["cpu", "cuda", "directml", "mps"] }
        },
        "minimumRamMb": { "type": "integer", "minimum": 0 },
        "minimumVramMb": { "type": "integer", "minimum": 0 },
        "minimumDiskMb": { "type": "integer", "minimum": 0 }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "trustRemoteCode": { "type": "boolean" },
        "preferSafetensors": { "type": "boolean" },
        "allowPickle": { "type": "boolean" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["base", "distilled", "quantized", "lora", "controlnet", "inpainting", "upscaler", "finetune", "unknown"] },
        "baseModel": { "type": "string" },
        "quantization": { "type": "string" },
        "architecture": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": { "enum": ["reviewed-catalog", "reviewed-manifest", "huggingface-metadata", "local-inspection", "unknown"] },
        "complete": { "type": "boolean" },
        "unresolved": { "type": "array", "items": { "type": "string" } },
        "tasks": { "type": "array", "items": { "type": "string" } },
        "negativePrompt": { "type": ["boolean", "null"] },
        "guidance": { "type": ["boolean", "null"] },
        "seed": { "type": ["boolean", "null"] },
        "steps": { "$ref": "#/$defs/numberCapability" },
        "guidanceScale": { "$ref": "#/$defs/numberCapability" },
        "supportedWidths": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "supportedHeights": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "widthMultiple": { "type": ["integer", "null"], "minimum": 1 },
        "heightMultiple": { "type": ["integer", "null"], "minimum": 1 },
        "dtypes": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "loraStrength": { "$ref": "#/$defs/numberCapability" },
        "controlStrength": { "$ref": "#/$defs/numberCapability" },
        "controlStart": { "$ref": "#/$defs/numberCapability" },
        "controlEnd": { "$ref": "#/$defs/numberCapability" },
        "denoiseStrength": { "$ref": "#/$defs/numberCapability" },
        "scales": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "tileSize": { "$ref": "#/$defs/numberCapability" },
        "tileOverlap": { "$ref": "#/$defs/numberCapability" }
      }
    },
    "expectedFiles": { "type": "array", "items": { "type": "string" } },
    "expectedSizeBytes": { "type": ["integer", "null"], "minimum": 0 },
    "needsConfiguration": { "type": "boolean" },
    "configurationIssues": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "numberCapability": {
      "type": ["object", "null"],
      "required": ["default", "minimum", "maximum"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "number" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "values": { "type": "array", "items": { "type": "number" } }
      }
    }
  }
}
